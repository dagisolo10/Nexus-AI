{
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": ["./src/renderer/**/*", "./src/preload/*.d.ts", "./src/shared/**/*"],
    "compilerOptions": {
        "composite": true,
        "types": ["node"],
        "jsx": "react-jsx",
        "resolvePackageJsonImports": true,
        "paths": {
            "@/*": ["./src/renderer/ui/*"],
            "@ui/*": ["./src/renderer/ui/*"],
            "@app/*": ["./src/renderer/src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    }
}
